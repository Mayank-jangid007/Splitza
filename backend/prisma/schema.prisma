// =============================================================
//  Splitza — Production Prisma Schema
//  Database: PostgreSQL  |  ORM: Prisma
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  MEMBER
  HOST
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PoolVisibility {
  PUBLIC
  PRIVATE
}

enum PoolStatus {
  DRAFT           // Host created, not published
  OPEN            // Accepting members
  FULL            // All seats taken
  ACTIVE          // Billing cycle running
  PAUSED          // Host paused the pool
  ENDED           // Billing cycle completed
  CANCELLED       // Cancelled before start
}

enum MembershipRole {
  HOST
  MEMBER
}

enum MembershipStatus {
  INVITED         // Private pool — invite sent, not yet accepted
  PENDING_PAYMENT // Accepted but UPI mandate not set up
  ACTIVE          // Mandate active, receiving access
  PAUSED          // Payment paused
  REMOVED         // Removed by host
  LEFT            // Self-exited
  EXPIRED         // Plan ended
}

enum TransactionType {
  MEMBER_COLLECTION   // Collected from a member
  HOST_DISBURSEMENT   // Released to host
  PLATFORM_FEE        // Splitza platform cut
  REFUND              // Refunded to member
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum EscrowCycleStatus {
  SCHEDULED       // Not yet started
  COLLECTING      // Collecting from all members
  COLLECTED       // All funds in escrow
  DISBURSING      // Releasing to host
  SETTLED         // Host paid, cycle closed
  PARTIAL_FAIL    // Some collections failed
  FAILED          // Full cycle failed
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_HOST_FAVOUR
  RESOLVED_MEMBER_FAVOUR
  CLOSED
}

enum NotificationType {
  INVITE_RECEIVED
  MEMBER_JOINED
  MEMBER_LEFT
  PAYMENT_COLLECTED
  PAYOUT_RELEASED
  CREDENTIALS_UPDATED
  PLAN_FULL
  PLAN_ENDED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  OTP_RELAY
  SYSTEM
}

// ─────────────────────────────────────────────
//  USER
// ─────────────────────────────────────────────

model User {
  id                 String             @id @default(uuid())
  email              String             @unique @db.VarChar(255)
  phone              String?            @unique @db.VarChar(15)
  name               String             @db.VarChar(120)
  avatarUrl          String?            @db.Text
  passwordHash       String?            @db.Text        // null when OAuth-only
  googleId           String?            @unique @db.VarChar(128)
  role               UserRole           @default(MEMBER)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  upiId              String?            @db.VarChar(80) // default payout UPI
  trustScore         Int                @default(100)   // 0–100
  isActive           Boolean            @default(true)
  lastLoginAt        DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  hostedPools        SplitPool[]        @relation("PoolHost")
  memberships        Membership[]
  transactions       Transaction[]
  escrowLedgers      EscrowLedger[]
  notifications      Notification[]
  raisedDisputes     Dispute[]          @relation("DisputeRaiser")
  auditLogs          AuditLog[]
  inviteLinks        InviteLink[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

// ─────────────────────────────────────────────
//  GLOBAL PLATFORM CONFIG  (admin-managed)
// ─────────────────────────────────────────────

model GlobalPlatformConfig {
  id                String      @id @default(uuid())
  slug              String      @unique @db.VarChar(64)  // e.g. "netflix-premium-4k"
  name              String      @db.VarChar(128)         // "Netflix Premium 4K"
  logoUrl           String?     @db.Text
  tier              String      @db.VarChar(64)          // "Premium", "Family", "Teams"
  maxSeats          Int                                  // hard cap e.g. 4
  pricePerMonth     Decimal     @db.Decimal(10, 2)       // ₹649.00
  currency          String      @default("INR") @db.VarChar(3)
  allowedCycles     Int[]                                // e.g. [1, 3, 6, 12]
  isActive          Boolean     @default(true)
  description       String?     @db.Text
  websiteUrl        String?     @db.Text
  termsUrl          String?     @db.Text
  sortOrder         Int         @default(0)              // display order

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  pools             SplitPool[]

  @@index([slug])
  @@index([isActive])
  @@map("global_platform_configs")
}

// ─────────────────────────────────────────────
//  SPLIT POOL  (a hosted subscription group)
// ─────────────────────────────────────────────

model SplitPool {
  id                  String         @id @default(uuid())
  hostId              String
  host                User           @relation("PoolHost", fields: [hostId], references: [id])

  // Official platform (null = custom)
  platformConfigId    String?
  platformConfig      GlobalPlatformConfig? @relation(fields: [platformConfigId], references: [id])

  // Custom plan fields (used when platformConfigId is null)
  customName          String?        @db.VarChar(128)
  customPricePerMonth Decimal?       @db.Decimal(10, 2)
  customMaxSeats      Int?

  // Derived / locked at creation
  isCustom            Boolean        @default(false)
  maxSeats            Int                               // locked from config or custom
  pricePerSeat        Decimal        @db.Decimal(10, 2) // per member per month
  planMonths          Int            @default(1)        // billing term in months
  currency            String         @default("INR") @db.VarChar(3)

  // Pool metadata
  visibility          PoolVisibility @default(PUBLIC)
  status              PoolStatus     @default(DRAFT)
  hostUpiId           String         @db.VarChar(80)   // payout UPI locked at creation
  platformFeePercent  Decimal        @default(5) @db.Decimal(5, 2) // e.g. 5.00 %

  startDate           DateTime?
  endDate             DateTime?
  autoRenew           Boolean        @default(false)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  credentials         PoolCredential?
  memberships         Membership[]
  escrowCycles        EscrowCycle[]
  escrowLedgers       EscrowLedger[]
  inviteLinks         InviteLink[]
  disputes            Dispute[]

  @@index([hostId])
  @@index([status])
  @@index([visibility, status])
  @@map("split_pools")
}

// ─────────────────────────────────────────────
//  POOL CREDENTIAL  (encrypted, one per pool)
// ─────────────────────────────────────────────

model PoolCredential {
  id                  String    @id @default(uuid())
  poolId              String    @unique
  pool                SplitPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  // All fields AES-256-GCM encrypted at rest
  encryptedUsername   String?   @db.Text
  encryptedPassword   String?   @db.Text
  encryptedInviteLink String?   @db.Text

  // Encryption envelope
  encryptionKeyId     String    @db.VarChar(64) // reference to KMS key version
  iv                  String    @db.VarChar(32) // base64 initialisation vector

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("pool_credentials")
}

// ─────────────────────────────────────────────
//  MEMBERSHIP  (user ↔ pool)
// ─────────────────────────────────────────────

model Membership {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  poolId          String
  pool            SplitPool        @relation(fields: [poolId], references: [id])

  role            MembershipRole   @default(MEMBER)
  status          MembershipStatus @default(PENDING_PAYMENT)
  priceAtJoin     Decimal          @db.Decimal(10, 2) // price locked at join time
  planMonthsAtJoin Int                                // term locked at join time

  // UPI mandate
  mandateId       String?          @db.VarChar(128)
  mandateStatus   String?          @db.VarChar(32)   // "ACTIVE" | "PAUSED" | "CANCELLED"
  mandateCreatedAt DateTime?

  joinedAt        DateTime         @default(now())
  leftAt          DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  transactions    Transaction[]

  @@unique([userId, poolId])
  @@index([poolId, status])
  @@index([userId])
  @@map("memberships")
}

// ─────────────────────────────────────────────
//  INVITE LINK  (for private pools)
// ─────────────────────────────────────────────

model InviteLink {
  id          String    @id @default(uuid())
  token       String    @unique @db.VarChar(64) // cryptographically random
  poolId      String
  pool        SplitPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])

  maxUses     Int?                // null = unlimited
  useCount    Int       @default(0)
  expiresAt   DateTime?
  isRevoked   Boolean   @default(false)

  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([poolId])
  @@map("invite_links")
}

// ─────────────────────────────────────────────
//  ESCROW CYCLE  (one per billing cycle per pool)
// ─────────────────────────────────────────────

model EscrowCycle {
  id              String            @id @default(uuid())
  poolId          String
  pool            SplitPool         @relation(fields: [poolId], references: [id])
  cycleNumber     Int                                      // 1, 2, 3 …
  status          EscrowCycleStatus @default(SCHEDULED)

  totalExpected   Decimal           @db.Decimal(12, 2)    // sum of all member dues
  totalCollected  Decimal           @default(0) @db.Decimal(12, 2)
  platformFee     Decimal           @default(0) @db.Decimal(12, 2)
  hostDisbursement Decimal          @default(0) @db.Decimal(12, 2)

  collectionStartAt DateTime?
  collectionEndAt   DateTime?
  disbursedAt       DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  transactions    Transaction[]

  @@unique([poolId, cycleNumber])
  @@index([poolId, status])
  @@map("escrow_cycles")
}

// ─────────────────────────────────────────────
//  ESCROW LEDGER (Scheduled Host Payouts)
// ─────────────────────────────────────────────

model EscrowLedger {
  id              String            @id @default(uuid())
  poolId          String
  pool            SplitPool         @relation(fields: [poolId], references: [id])
  hostId          String
  host            User              @relation(fields: [hostId], references: [id])
  
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("INR") @db.VarChar(3)
  
  scheduledFor    DateTime
  status          TransactionStatus @default(PENDING)
  processedAt     DateTime?
  
  transactionId   String?           @db.VarChar(128)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([poolId])
  @@index([hostId])
  @@index([status, scheduledFor])
  @@map("escrow_ledger")
}

// ─────────────────────────────────────────────
//  TRANSACTION  (every money movement)
// ─────────────────────────────────────────────

model Transaction {
  id              String            @id @default(uuid())
  type            TransactionType
  status          TransactionStatus @default(PENDING)

  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("INR") @db.VarChar(3)

  // Relations
  userId          String
  user            User              @relation(fields: [userId], references: [id])

  membershipId    String?
  membership      Membership?       @relation(fields: [membershipId], references: [id])

  escrowCycleId   String?
  escrowCycle     EscrowCycle?      @relation(fields: [escrowCycleId], references: [id])

  // Payment gateway references
  upiTransactionId String?          @db.VarChar(128)
  razorpayOrderId  String?          @db.VarChar(128)
  razorpayPaymentId String?         @db.VarChar(128)
  mandateId        String?          @db.VarChar(128)
  failureReason    String?          @db.Text

  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([escrowCycleId])
  @@index([membershipId])
  @@index([status])
  @@map("transactions")
}

// ─────────────────────────────────────────────
//  DISPUTE
// ─────────────────────────────────────────────

model Dispute {
  id          String        @id @default(uuid())
  poolId      String
  pool        SplitPool     @relation(fields: [poolId], references: [id])
  raisedById  String
  raisedBy    User          @relation("DisputeRaiser", fields: [raisedById], references: [id])

  reason      String        @db.Text
  evidence    Json?                   // { urls: string[], description: string }
  status      DisputeStatus @default(OPEN)
  resolution  String?       @db.Text
  resolvedAt  DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([poolId])
  @@index([status])
  @@map("disputes")
}

// ─────────────────────────────────────────────
//  NOTIFICATION
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.Text
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?

  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
//  AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(128)  // "POOL_CREATED" | "CREDENTIAL_UPDATED" | …
  entity     String   @db.VarChar(64)   // "SplitPool" | "User" | "Membership"
  entityId   String   @db.VarChar(64)
  ipAddress  String?  @db.VarChar(45)   // IPv4 or IPv6
  userAgent  String?  @db.Text
  metadata   Json?

  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
